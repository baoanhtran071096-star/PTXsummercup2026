# ============================================================
# PTX Summer Cup 2026 – Environment Configuration
# AI-Native, Free-by-Design
# ============================================================
# Sao chép file này thành .env và điền các giá trị thực

# ─── GEMINI AI (Google AI Studio – Free Tier) ───────────────
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# ─── SUPABASE (Database – Free Tier) ────────────────────────
# Lấy tại: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ─── ADMIN CREDENTIALS ──────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
JWT_SECRET=ptx-super-secret-jwt-key-2026

# ─── APPLICATION ────────────────────────────────────────────
NODE_ENV=development
PORT=8000
APP_NAME=PTX Summer Cup 2026
APP_URL=http://localhost:8000

# ─── AI COST GUARD (Evolution Backlog) ──────────────────────
# Giới hạn quota để tránh vượt Free Tier
AI_DAILY_REQUEST_LIMIT=500
AI_MAX_TOKENS_PER_REQUEST=8192
